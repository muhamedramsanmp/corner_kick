          [data-uds-child='quantity-selector'] button,
          [data-uds-child='quantity-selector'] button * {
            border-radius: 0 !important;
            -webkit-tap-highlight-color: transparent !important;
            tap-highlight-color: transparent !important;
          }

          /* Disabled button styles */
          [data-uds-child='quantity-selector'] button:disabled,
          [data-uds-child='quantity-selector'] button:disabled * {
            cursor: not-allowed !important;
            pointer-events: none !important;
          }

          [data-uds-child='quantity-selector']
            button:disabled
            [data-uds-child='action-icon-icon'] {
            background-color: #e5e5e5 !important; /* neutral-20 */
          }

          /* Remove hover effects on disabled buttons */
          [data-uds-child='quantity-selector'] button:disabled:hover,
          [data-uds-child='quantity-selector']
            button:disabled:hover
            [data-uds-child='action-icon-icon'] {
            background: #e5e5e5 !important; /* neutral-20 */
            background-color: #e5e5e5 !important;
          }

          /* On touch devices: disable hover but allow active state */
          @media (hover: none) and (pointer: coarse) {
            /* Disable persistent hover after tap */
            [data-uds-child='quantity-selector'] button:hover,
            [data-uds-child='quantity-selector']
              button:hover
              [data-uds-child='action-icon-icon'] {
              background: none !important;
              background-color: transparent !important;
            }

            /* Enable active state while pressing */
            [data-uds-child='quantity-selector']
              button:active
              [data-uds-child='action-icon-icon'] {
              background-color: rgba(0, 0, 0, 0.2) !important;
            }

            /* Disabled buttons should not have active state */
            [data-uds-child='quantity-selector']
              button:disabled:active
              [data-uds-child='action-icon-icon'] {
              background-color: #e5e5e5 !important; /* neutral-20 */
            }
          }
